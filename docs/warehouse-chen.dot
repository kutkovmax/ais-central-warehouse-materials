graph warehouse_chen {
    graph [
        label="Концептуальная модель данных АИС «Склад-МехПром» — нотация Чена"
        labelloc=t
        rankdir=LR
        splines=ortho
        nodesep=0.55
        ranksep=1.0
        bgcolor="white"
        fontname="Arial"
    ]

    edge [
        dir=none
        fontname="Arial"
        fontsize=9
        color="#475569"
    ]

    // Сущности: прямоугольники
    node [
        shape=box
        style="filled"
        fillcolor="#EAF2F8"
        color="#1F4E79"
        penwidth=1.5
        fontname="Arial"
        fontsize=10
    ]

    UOM [label="Единица измерения\n(UOM)"]
    SKU [label="Номенклатура\n(SKU)"]
    ZONE [label="Зона склада\n(WAREHOUSE_ZONE)"]
    CELL [label="Ячейка хранения\n(STORAGE_CELL)"]
    SUPPLIER [label="Поставщик\n(SUPPLIER)"]
    RECEIPT [label="Приходный ордер\n(RECEIPT_ORDER)"]
    BATCH [label="Партия материала\n(BATCH)"]
    QC [label="Протокол ОТК\n(QC_PROTOCOL)"]
    BALANCE [label="Остаток в ячейке\n(LOCATION_BALANCE)"]
    DEPARTMENT [label="Производственный цех\n(DEPARTMENT)"]
    REQUEST [label="Требование М-11\n(ISSUE_REQUEST)"]
    REQUEST_ITEM [label="Строка требования\n(REQUEST_ITEM)"]

    // Связи: ромбы
    node [
        shape=diamond
        style="filled"
        fillcolor="#FEF3C7"
        color="#A16207"
        penwidth=1.3
        fontname="Arial"
        fontsize=9
    ]

    R_UOM_SKU [label="имеет\nединицу"]
    R_ZONE_CELL [label="содержит"]
    R_SUPPLIER_RECEIPT [label="поставляет"]
    R_RECEIPT_BATCH [label="включает"]
    R_SKU_BATCH [label="классифицирует"]
    R_BATCH_QC [label="проходит\nконтроль"]
    R_BATCH_BALANCE [label="учитывается\nв"]
    R_CELL_BALANCE [label="содержит\nостаток"]
    R_DEPT_REQUEST [label="создаёт"]
    R_REQUEST_ITEM [label="содержит"]
    R_ITEM_SKU [label="запрашивает"]
    R_ITEM_BALANCE [label="резервирует"]

    // Атрибуты: овалы
    node [
        shape=ellipse
        style="filled"
        fillcolor="#F8FAFC"
        color="#64748B"
        penwidth=1.0
        fontname="Arial"
        fontsize=8
    ]

    A_UOM_CODE [label="код ОКЕИ"]
    A_UOM_NAME [label="наименование"]
    A_SKU_ARTICLE [label="артикул"]
    A_SKU_NAME [label="наименование"]
    A_SKU_CATEGORY [label="категория"]
    A_ZONE_CODE [label="код зоны"]
    A_ZONE_TYPE [label="тип зоны"]
    A_CELL_ADDRESS [label="адрес ячейки"]
    A_CELL_STATUS [label="статус ячейки"]
    A_SUPPLIER_INN [label="ИНН"]
    A_SUPPLIER_NAME [label="наименование"]
    A_RECEIPT_NUMBER [label="номер М-4"]
    A_RECEIPT_STATUS [label="статус прихода"]
    A_BATCH_NUMBER [label="номер партии"]
    A_BATCH_QC_STATUS [label="статус ОТК"]
    A_BATCH_QUANTITY [label="текущий остаток"]
    A_QC_VERDICT [label="вердикт"]
    A_QC_CERTIFICATE [label="сертификат"]
    A_BALANCE_PHYSICAL [label="физическое количество"]
    A_BALANCE_RESERVED [label="зарезервированное количество"]
    A_DEPT_CODE [label="код цеха"]
    A_DEPT_NAME [label="наименование"]
    A_REQUEST_NUMBER [label="номер М-11"]
    A_REQUEST_STATUS [label="статус требования"]
    A_ITEM_REQUESTED [label="запрошенное количество"]
    A_ITEM_ALLOCATED [label="зарезервированное количество"]
    A_ITEM_ISSUED [label="выданное количество"]

    // Связи между сущностями и отношениями с кардинальностями
    UOM -- R_UOM_SKU [label="1"]
    R_UOM_SKU -- SKU [label="N"]

    ZONE -- R_ZONE_CELL [label="1"]
    R_ZONE_CELL -- CELL [label="N"]

    SUPPLIER -- R_SUPPLIER_RECEIPT [label="1"]
    R_SUPPLIER_RECEIPT -- RECEIPT [label="N"]

    RECEIPT -- R_RECEIPT_BATCH [label="1"]
    R_RECEIPT_BATCH -- BATCH [label="N"]

    SKU -- R_SKU_BATCH [label="1"]
    R_SKU_BATCH -- BATCH [label="N"]

    BATCH -- R_BATCH_QC [label="1"]
    R_BATCH_QC -- QC [label="0..1"]

    BATCH -- R_BATCH_BALANCE [label="1"]
    R_BATCH_BALANCE -- BALANCE [label="N"]
    CELL -- R_CELL_BALANCE [label="1"]
    R_CELL_BALANCE -- BALANCE [label="N"]

    DEPARTMENT -- R_DEPT_REQUEST [label="1"]
    R_DEPT_REQUEST -- REQUEST [label="N"]

    REQUEST -- R_REQUEST_ITEM [label="1"]
    R_REQUEST_ITEM -- REQUEST_ITEM [label="N"]

    SKU -- R_ITEM_SKU [label="1"]
    R_ITEM_SKU -- REQUEST_ITEM [label="N"]

    REQUEST_ITEM -- R_ITEM_BALANCE [label="1"]
    R_ITEM_BALANCE -- BALANCE [label="N"]

    // Атрибуты сущностей
    UOM -- A_UOM_CODE
    UOM -- A_UOM_NAME
    SKU -- A_SKU_ARTICLE
    SKU -- A_SKU_NAME
    SKU -- A_SKU_CATEGORY
    ZONE -- A_ZONE_CODE
    ZONE -- A_ZONE_TYPE
    CELL -- A_CELL_ADDRESS
    CELL -- A_CELL_STATUS
    SUPPLIER -- A_SUPPLIER_INN
    SUPPLIER -- A_SUPPLIER_NAME
    RECEIPT -- A_RECEIPT_NUMBER
    RECEIPT -- A_RECEIPT_STATUS
    BATCH -- A_BATCH_NUMBER
    BATCH -- A_BATCH_QC_STATUS
    BATCH -- A_BATCH_QUANTITY
    QC -- A_QC_VERDICT
    QC -- A_QC_CERTIFICATE
    BALANCE -- A_BALANCE_PHYSICAL
    BALANCE -- A_BALANCE_RESERVED
    DEPARTMENT -- A_DEPT_CODE
    DEPARTMENT -- A_DEPT_NAME
    REQUEST -- A_REQUEST_NUMBER
    REQUEST -- A_REQUEST_STATUS
    REQUEST_ITEM -- A_ITEM_REQUESTED
    REQUEST_ITEM -- A_ITEM_ALLOCATED
    REQUEST_ITEM -- A_ITEM_ISSUED
}
